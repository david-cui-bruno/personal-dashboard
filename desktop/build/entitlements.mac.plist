<?xml version="1.0" encoding="UTF-8"?>
<!-- Hardened-runtime entitlements required to notarize an Electron app (#112).
     Electron's Chromium needs JIT + unsigned executable memory; the app is a
     network client (it loads the hosted web app). Nothing else is requested. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
