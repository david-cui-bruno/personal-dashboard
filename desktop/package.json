{
  "name": "notes-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "notes — Electron desktop shell (#110). Hosted-URL wrapper of the web app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "APP_URL=http://localhost:3000 electron .",
    "smoke": "SMOKE=1 APP_URL=http://localhost:3000 electron .",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "health.framewise.notes",
    "productName": "notes",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  }
}
